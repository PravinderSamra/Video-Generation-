# Copy to .env and fill in what you use. Every value here is free.
# Real environment variables always override this file.

# --- Stage 1: enrichment -----------------------------------------------------
# Local LLM (default). Install https://ollama.com, then: ollama pull qwen3:8b
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# Hosted fallback. Free token: https://huggingface.co/settings/tokens
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxx
HF_BASE_URL=https://router.huggingface.co/v1
HF_TEXT_MODEL=Qwen/Qwen3-8B

# --- Stage 2: generation -----------------------------------------------------
# Local LTX-Video checkout (default backend).
#   git clone https://github.com/Lightricks/LTX-Video
#   cd LTX-Video && pip install -e .[inference]
# LTX_REPO=/absolute/path/to/LTX-Video

# Wan2GP, for the quality path. Start with: python wgp.py --api
WAN2GP_URL=http://localhost:7860
# WAN2GP_API_ROUTE=/api/generate

# ComfyUI, for multi-step graphs. Start with: python main.py --listen
COMFYUI_URL=http://localhost:8188

# Hosted video model. Check what is currently served on the free tier at
# https://huggingface.co/models?pipeline_tag=text-to-video&inference_provider=all
HF_VIDEO_MODEL=Lightricks/LTX-Video

REQUEST_TIMEOUT=180
